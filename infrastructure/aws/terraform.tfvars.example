# Example Terraform Variables for EMYC Staging Capacity Validation
# Copy this file to terraform.tfvars and populate with actual credentials:
#   cp terraform.tfvars.example terraform.tfvars
#
# DO NOT COMMIT terraform.tfvars TO VERSION CONTROL.

aws_region            = "us-east-1"
environment           = "staging"
app_image             = "123456789012.dkr.ecr.us-east-1.amazonaws.com/emyc-app:latest"

# Database Configuration
db_instance_class     = "db.m6g.xlarge" # 4 vCPU, 16 GB RAM Graviton3
db_allocated_storage  = 100
db_iops               = 12000          # 12k IOPS for 500+ writes/sec WAL throughput
db_name               = "competition_staging_db"
db_username           = "postgres"
db_password           = "REPLACE_WITH_SECURE_RANDOMLY_GENERATED_PASSWORD"

# ECS Fargate Sizing
fargate_desired_count = 4              # Baseline calibration tasks
fargate_max_count     = 32             # Max autoscaling surge tasks for 100k

# Application Configuration
PROJECT_NAME="Telegram Competitive Exam Platform"
DEBUG=false
ENVIRONMENT="development"

# Database Configuration (PostgreSQL / Supabase)
# Standard format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/competition_db"
# Fallback / Direct synchronous URL for Alembic if required
DATABASE_SYNC_URL="postgresql://postgres:postgres@localhost:5432/competition_db"

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="your_bot_token_here"
BOT_MODE="polling" # "polling" for local dev, "webhook" for production
WEBHOOK_URL="https://your-domain.com/api/v1/webhook"
WEBHOOK_SECRET="a_secure_random_string_for_telegram_secret"

# Admin Access Control
# Comma-separated list of numeric Telegram User IDs authorized as administrators
ADMIN_TELEGRAM_IDS="123456789,987654321"

# Membership Verification
MEMBERSHIP_ADAPTER_TYPE="mock" # "mock" or "http"
MEMBERSHIP_API_URL="https://membership.example.com/api/v1/verify"
MEMBERSHIP_API_KEY=""

# Internationalization
DEFAULT_LANGUAGE="en"

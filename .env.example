# ==============================================================================
# EMYC Telegram Competitive Exam Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development: cp .env.example .env
# For Render deployment, configure these keys in the Render Dashboard Environment tab.
# NEVER commit real credentials or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# [OPTIONAL] Application display name
PROJECT_NAME="Telegram Competitive Exam Platform"

# [DEVELOPMENT ONLY] Set to true only during local debugging. Must be false in production.
DEBUG=false

# [REQUIRED IN PRODUCTION] "production", "staging", or "development"
ENVIRONMENT="production"


# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION]
# PostgreSQL connection string with asyncpg driver.
# If copying directly from Supabase (starts with postgresql:// or postgres://),
# the platform automatically normalizes it to postgresql+asyncpg://.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+asyncpg://postgres:your_password@your_supabase_host:5432/postgres"

# [OPTIONAL / DEVELOPMENT] Synchronous fallback URL if required by certain CLI tools
DATABASE_SYNC_URL="postgresql://postgres:your_password@your_supabase_host:5432/postgres"


# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION]
# Bot token obtained from Telegram's @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"

# [REQUIRED IN PRODUCTION]
# "webhook" for Render production deployment; "polling" for local development only.
BOT_MODE="webhook"

# [REQUIRED IN PRODUCTION when BOT_MODE=webhook]
# The public HTTPS URL where Render serves this application + webhook endpoint.
# Format: https://<your-render-service-subdomain>.onrender.com/api/v1/telegram/webhook
WEBHOOK_URL="https://your-service.onrender.com/api/v1/telegram/webhook"

# [REQUIRED IN PRODUCTION when BOT_MODE=webhook]
# Secret token to ensure updates originate strictly from Telegram Bot API.
# Generate a cryptographically random string (1-256 characters: A-Z, a-z, 0-9, _, -).
WEBHOOK_SECRET="your_cryptographically_secure_random_token_here"


# ------------------------------------------------------------------------------
# 4. ADMINISTRATIVE ACCESS CONTROL
# ------------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION]
# Comma-separated list of numeric Telegram User IDs authorized to access /admin commands.
# Example: "123456789,987654321"
ADMIN_TELEGRAM_IDS="123456789"


# ------------------------------------------------------------------------------
# 5. MEMBERSHIP VERIFICATION ADAPTER
# ------------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION]
# "mock" for local testing; "http" for live EMYC central membership API.
MEMBERSHIP_ADAPTER_TYPE="mock"

# [OPTIONAL / REQUIRED if MEMBERSHIP_ADAPTER_TYPE=http]
# Base URL for the official EMYC membership verification API
MEMBERSHIP_API_URL="https://membership.example.com/api/v1/verify"

# [OPTIONAL / REQUIRED if MEMBERSHIP_ADAPTER_TYPE=http]
# Secret API key used to authenticate with the EMYC membership service
MEMBERSHIP_API_KEY=""


# ------------------------------------------------------------------------------
# 6. LOCALIZATION & COMPETITION POLICIES
# ------------------------------------------------------------------------------
# [OPTIONAL] Fallback default language: "en", "am", "om", "ar"
DEFAULT_LANGUAGE="en"

# [OPTIONAL] Early closure policy: "truncate_to_close_time" or "allow_in_progress_to_finish"
MANUAL_EARLY_CLOSURE_POLICY="truncate_to_close_time"
